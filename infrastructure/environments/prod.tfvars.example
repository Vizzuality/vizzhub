# Production Environment Configuration
# Copy this file and fill in your values

# General
project_name = "hub"
environment  = "prod"
aws_region   = "eu-west-1"

# Network (defaults are fine for most cases)
# vpc_cidr             = "10.0.0.0/16"
# public_subnet_cidr   = "10.0.1.0/24"
# private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24"]
# availability_zones   = ["eu-west-1a", "eu-west-1b"]

# EC2
ec2_instance_type = "t3.medium"
# ec2_ami_id = ""  # Leave empty for latest Amazon Linux 2023

# RDS
rds_instance_class    = "db.t4g.small"
rds_allocated_storage = 20
rds_engine_version    = "16"
rds_backup_retention  = 7

# Domain (REQUIRED - fill in your values)
domain_name = "hub.vizzuality.com"
admin_email = ""  # For Let's Encrypt - REQUIRED

# GitHub OIDC (REQUIRED - fill in your values)
github_org  = ""  # e.g., "Vizzuality"
github_repo = ""  # e.g., "project-score-card"

# Monitoring (optional - leave empty to disable alarms)
alarm_email = ""

# Production Environment Configuration
# Copy to prod.tfvars and fill in your values
# IMPORTANT: prod.tfvars is gitignored - never commit secrets!

# =============================================================================
# AWS
# =============================================================================
aws_account_id = ""          # Your AWS account ID
aws_region     = "eu-west-3" # Paris
aws_profile    = ""          # AWS CLI profile name (e.g., "default" or custom)

# =============================================================================
# General
# =============================================================================
project_name = "hub"
environment  = "prod"

# =============================================================================
# Network (defaults are fine for most cases)
# =============================================================================
# vpc_cidr              = "10.0.0.0/16"
# public_subnet_cidrs   = ["10.0.1.0/24", "10.0.2.0/24"]
# private_subnet_cidrs  = ["10.0.10.0/24", "10.0.11.0/24"]
# availability_zones    = ["eu-west-3a", "eu-west-3b"]

# =============================================================================
# Compute - Free tier eligible (uses ECS-optimized AMI with Docker)
# =============================================================================
ec2_instance_type = "t3.micro"  # Free tier: 750 hrs/month for 12 months

# =============================================================================
# Database - Free tier eligible
# =============================================================================
rds_instance_class    = "db.t3.micro"  # Free tier: 750 hrs/month for 12 months
rds_allocated_storage = 20             # Free tier: up to 20GB
rds_engine_version    = "16"
rds_backup_retention  = 7

# =============================================================================
# Domain
# =============================================================================
domain_name = "hub.vizzuality.com"

# =============================================================================
# GitHub (for OIDC and API access)
# =============================================================================
github_org   = "Vizzuality"
github_repo  = "vizzhub"
github_token = ""  # Personal access token with repo scope

# =============================================================================
# Google OAuth (from Google Cloud Console)
# =============================================================================
google_client_id     = ""
google_client_secret = ""

# =============================================================================
# Jira OAuth (from Atlassian Developer Console)
# =============================================================================
jira_client_id     = ""
jira_client_secret = ""

# =============================================================================
# Slack (optional)
# =============================================================================
slack_bot_token = ""

# =============================================================================
# Monitoring (optional)
# =============================================================================
alarm_email = ""

# =============================================================================
# Cost Estimate
# =============================================================================
# With free tier (first 12 months):
#   EC2 t3.micro:     $0
#   RDS db.t3.micro:  $0
#   ALB:              ~$16/month
#   Secrets Manager:  ~$2/month
#   Total:            ~$18/month
#
# After free tier:
#   EC2 t3.micro:     ~$8/month
#   RDS db.t3.micro:  ~$13/month
#   ALB:              ~$16/month
#   Secrets Manager:  ~$2/month
#   Total:            ~$39/month

# Database
DATABASE_URL=

# Security (REQUIRED - Generate secure random keys for production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-secret-key-here-change-in-production
SESSION_SECRET_KEY=your-session-secret-here-change-in-production

# Jira OAuth 2.0 (Recommended)
# Create OAuth app at: https://developer.atlassian.com/console/myapps/
JIRA_OAUTH_CLIENT_ID=your-client-id
JIRA_OAUTH_CLIENT_SECRET=your-client-secret
JIRA_OAUTH_REDIRECT_URI=
# OAuth scopes - need both classic AND granular for full functionality:
# - Classic: read:jira-work, read:jira-user (for search, issues)
# - Granular: read:board-scope:jira-software, read:sprint:jira-software (for Agile API)
JIRA_OAUTH_SCOPES=read:jira-work read:jira-user read:issue-details:jira read:user:jira read:project:jira read:board-scope:jira-software read:sprint:jira-software offline_access


# GitHub
GITHUB_TOKEN=your-github-token
GITHUB_ORG=your-org


# Application
# DEBUG: Enable development mode
# - When true: Bypasses authentication if no token provided (uses mock dev user)
# - When false: Always requires authentication (production mode)
# WARNING: NEVER set to true in production
# TODO: Replace with Google OAuth (Google Sign-In) for production authentication
DEBUG=true
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Redis (for async job queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

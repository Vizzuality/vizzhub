# Database
DATABASE_URL=

# Security (REQUIRED - Generate secure random keys for production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-secret-key-here-change-in-production
SESSION_SECRET_KEY=your-session-secret-here-change-in-production
JWT_EXPIRE_HOURS=24

# Google OAuth (for user authentication via Google Sign-In)
# Create OAuth app at: https://console.cloud.google.com/apis/credentials
# Required scopes: openid, email, profile
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Restrict login to users from this domain (leave empty to allow any Google account)
ALLOWED_GOOGLE_DOMAIN=vizzuality.com
# Email of initial admin user (created on first login)
INITIAL_ADMIN_EMAIL=

# Jira OAuth 2.0 (Recommended)
# Create OAuth app at: https://developer.atlassian.com/console/myapps/
JIRA_OAUTH_CLIENT_ID=your-client-id
JIRA_OAUTH_CLIENT_SECRET=your-client-secret
JIRA_OAUTH_REDIRECT_URI=
# Note: OAuth scopes are hardcoded in OAuthService.JIRA_REQUIRED_SCOPES (no env var needed)


# Application
# DEBUG: Enable development mode
# - When true: Bypasses authentication if no token provided (uses mock dev user)
# - When false: Always requires authentication (production mode)
# WARNING: NEVER set to true in production
# TODO: Replace with Google OAuth (Google Sign-In) for production authentication
DEBUG=true
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# OAuth token encryption key (required for token storage)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_ENCRYPTION_KEY=

# Redis (for async job queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

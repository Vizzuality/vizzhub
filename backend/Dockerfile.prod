# Production Dockerfile for backend
# Multi-stage build for smaller image size
# syntax=docker/dockerfile:1

FROM python:3.13-slim AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# Production stage
FROM python:3.13-slim

WORKDIR /app

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/bash appuser

# Copy Python packages from builder with secure permissions (read-only except bins)
# --chmod=555 = r-xr-xr-x (read+execute, no write)
COPY --from=builder --chown=appuser:appuser --chmod=555 /root/.local /home/appuser/.local

# Copy application code with secure permissions (read-only)
# --chmod=555 for dirs (need execute to traverse), files get 444 via find below
COPY --chown=appuser:appuser --chmod=555 . .

# Ensure files are read-only, except entrypoint which needs execute
RUN find /app -type f -exec chmod 444 {} \; && chmod 555 /app/entrypoint.sh

# Set environment
ENV PATH=/home/appuser/.local/bin:$PATH
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Switch to non-root user
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

EXPOSE 8000

CMD ["./entrypoint.sh"]

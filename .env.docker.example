# Docker Compose Environment Variables
# Copy this file to .env.docker for local development
# DO NOT commit .env.docker to git

# Database credentials (used by docker-compose.yml)
# SECURITY: Use strong passwords in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(16))"
DB_USER=scorecard
DB_PASSWORD=scorecard-ci
DB_NAME=scorecard

# Application settings
DEBUG=true
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Security keys (REQUIRED - Generate secure random keys)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-jwt-secret-key-here
SESSION_SECRET_KEY=your-session-secret-key-here

# Jira OAuth 2.0 (copy from backend/.env)
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
JIRA_OAUTH_REDIRECT_URI=http://localhost:8000/api/oauth/jira/callback
JIRA_OAUTH_SCOPES=read:jira-work read:jira-user

# GitHub
GITHUB_TOKEN=
GITHUB_ORG=
